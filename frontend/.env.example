# URL base del backend Spring Boot
# Obligatorio HTTPS en entornos distintos a desarrollo local.
VITE_API_URL=http://localhost:8080

# Muestra el boton de login con Google (ocultalo si el backend corre sin perfil oauth2)
VITE_OAUTH2_ENABLED=true

# Servidor de desarrollo con TLS (opcional).
# Genera un certificado local (por ejemplo con mkcert) y define las rutas
# antes de ejecutar `npm run dev` para probar el flujo sobre HTTPS.
VITE_HTTPS=false
VITE_HTTPS_CERT=
VITE_HTTPS_KEY=
