{
	"info": {
		"_postman_id": "b7f1c2a4-5d63-4e91-9a2f-proy0glob",
		"name": "Proyecto Global - API",
		"description": "Pruebas funcionales de la API. Cubre los criterios de aceptacion de las historias S1-01 (infraestructura), S1-02 (modelo usuarios/roles) y S1-04 (registro, login, JWT y RBAC).\n\nREQUISITOS\n- Backend levantado en el puerto 8080.\n- Para la prueba de COORDINADOR: crear el usuario y promoverlo en la base de datos, porque todavia no existe endpoint de administracion de usuarios (eso es la historia S1-02).\n\nSQL para promover a COORDINADOR:\nUPDATE usuarios SET rol_id = (SELECT id FROM roles WHERE nombre = 'COORDINADOR') WHERE email = 'correo.coordinador@escuela.edu';\n\nComo verificar: Newman's runner esta en postman/run-newman.ps1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 Infraestructura",
			"item": [
				{
					"name": "CORS - preflight OPTIONS",
					"request": {
						"method": "OPTIONS",
						"header": [
							{ "key": "Origin", "value": "http://localhost:5173" },
							{ "key": "Access-Control-Request-Method", "value": "POST" },
							{ "key": "Access-Control-Request-Headers", "value": "content-type, authorization" }
						],
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('preflight responde 200', function () { pm.response.to.have.status(200); });",
									"pm.test('devuelve Access-Control-Allow-Origin', function () { pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173'); });",
									"pm.test('devuelve Access-Control-Allow-Methods', function () { pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'); });",
									"pm.test('devuelve Access-Control-Allow-Headers', function () { pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.be.a('string'); });"
								]
							}
						}
					]
				},
				{
					"name": "Contrato de error 404",
					"request": {
						"method": "GET",
						"header": [{ "key": "Origin", "value": "http://localhost:5173" }],
						"url": { "raw": "{{baseUrl}}/api/planeaciones", "host": ["{{baseUrl}}"], "path": ["api", "planeaciones"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('recurso inexistente responde 404', function () { pm.response.to.have.status(404); });",
									"pm.test('cuerpo de error con el contrato ApiErrorResponse', function () {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.have.property('timestamp');",
									"  pm.expect(body.status).to.eql(404);",
									"  pm.expect(body.error).to.eql('Not Found');",
									"  pm.expect(body.message).to.be.a('string');",
									"  pm.expect(body.path).to.eql('/api/planeaciones');",
									"  pm.expect(body.fieldErrors).to.eql({});",
									"  pm.expect(body.details).to.eql([]);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Ruta protegida responde 401 sin token",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('sin token responde 401', function () { pm.response.to.have.status(401); });",
									"pm.test('mensaje de sesion requerida', function () { pm.expect(pm.response.json().message).to.eql('Debes iniciar sesion para acceder a este recurso'); });"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "02 Registro",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (!pm.environment.get('correoDocente')) {",
							"  const sufijo = pm.variables.replaceIn('{{$randomUUID}}').substring(0, 8);",
							"  pm.environment.set('correoDocenteMayus', 'MAYUS.' + sufijo + '@ESCUELA.EDU');",
							"  pm.environment.set('correoDocente', 'docente.' + sufijo + '@escuela.edu');",
							"  pm.environment.set('correoCoordinador', 'coord.' + sufijo + '@escuela.edu');",
							"  pm.environment.set('correoInexistente', 'nadie.' + sufijo + '@escuela.edu');",
							"  console.log('Correo de prueba generado: ' + pm.environment.get('correoDocente'));",
							"}"
						]
					}
				}
			],
			"item": [
				{
					"name": "Registro crea usuario con rol DOCENTE",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Docente de prueba\",\n  \"email\": \"{{correoDocente}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"const body = pm.response.json();",
									"pm.test('el rol inicial es DOCENTE', function () { pm.expect(body.rol).to.eql('DOCENTE'); });",
									"pm.test('queda activo', function () { pm.expect(body.activo).to.eql(true); });",
									"pm.test('respuesta con el correo normalizado', function () { pm.expect(body.email).to.eql(pm.environment.get('correoDocente').toLowerCase()); });",
									"pm.test('nunca expone el hash de la contrasena', function () { pm.expect(body).to.not.have.property('password'); });",
									"pm.collectionVariables.set('idUsuario', body.id);"
								]
							}
						}
					]
				},
				{
					"name": "Registro con correo duplicado responde 409",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Docente de prueba\",\n  \"email\": \"{{correoDocente}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('409 Conflict por correo duplicado', function () { pm.response.to.have.status(409); });",
									"pm.test('mensaje de duplicado', function () { pm.expect(pm.response.json().message).to.include('ya esta registrado'); });"
								]
							}
						}
					]
				},
				{
					"name": "Registro normaliza el correo a minusculas",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Docente Mayusculas\",\n  \"email\": \"{{correoDocenteMayus}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"pm.test('el correo queda en minusculas', function () { pm.expect(pm.response.json().email).to.eql(pm.environment.get('correoDocenteMayus').toLowerCase()); });"
								]
							}
						}
					]
				},
				{
					"name": "Registro con datos invalidos responde 400",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"\",\n  \"email\": \"esto-no-es-correo\",\n  \"password\": \"123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
									"const errores = pm.response.json().fieldErrors;",
									"pm.test('errores por campo', function () {",
									"  pm.expect(errores).to.have.property('nombre');",
									"  pm.expect(errores).to.have.property('email');",
									"  pm.expect(errores).to.have.property('password');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "03 Login y JWT",
			"item": [
				{
					"name": "Login devuelve token JWT",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{correoDocente}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"pm.test('devuelve token no vacio', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });",
									"pm.test('tipo Bearer', function () { pm.expect(body.tipo).to.eql('Bearer'); });",
									"pm.test('informa el vencimiento', function () { pm.expect(body.expiraEnSegundos).to.eql(3600); });",
									"pm.test('incluye el usuario y su rol', function () {",
									"  pm.expect(body.usuario.email).to.eql(pm.environment.get('correoDocente').toLowerCase());",
									"  pm.expect(body.usuario.rol).to.eql('DOCENTE');",
									"});",
									"pm.test('el token tiene tres segmentos de firma JWT', function () { pm.expect(body.token.split('.')).to.have.lengthOf(3); });",
									"pm.environment.set('token', body.token);"
								]
							}
						}
					]
				},
				{
					"name": "Login con contrasena incorrecta responde 401",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{correoDocente}}\",\n  \"password\": \"ContrasenaEquivocada999\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
									"pm.test('mensaje generico', function () { pm.expect(pm.response.json().message).to.eql('Credenciales invalidas'); });"
								]
							}
						}
					]
				},
				{
					"name": "Login con correo inexistente responde 401",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{correoInexistente}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
									"pm.test('no revela si el correo existe', function () { pm.expect(pm.response.json().message).to.eql('Credenciales invalidas'); });"
								]
							}
						}
					]
				},
				{
					"name": "GET /me con token valido",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
									"pm.test('devuelve el usuario del token', function () {",
									"  pm.expect(pm.response.json().email).to.eql(pm.environment.get('correoDocente').toLowerCase());",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET /me con token invalido",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer token.invalido.falso" }],
						"url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "04 RBAC por rol",
			"item": [
				{
					"name": "DOCENTE no puede listar usuarios (403)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('403 Forbidden para DOCENTE', function () { pm.response.to.have.status(403); });",
									"pm.test('mensaje de permisos', function () { pm.expect(pm.response.json().message).to.eql('No tienes permisos para acceder a este recurso'); });"
								]
							}
						}
					]
				},
				{
					"name": "COORDINADOR puede listar usuarios (200)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{tokenCoordinador}}" }],
						"url": { "raw": "{{baseUrl}}/api/auth/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "auth", "usuarios"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK para COORDINADOR', function () { pm.response.to.have.status(200); });",
									"pm.test('devuelve una coleccion de usuarios', function () {",
									"  const body = pm.response.json();",
									"  pm.expect(body).to.be.an('array');",
									"  body.forEach(u => {",
									"    pm.expect(u).to.have.property('email');",
									"    pm.expect(u).to.not.have.property('password');",
									"  });",
									"});"
								]
							}
						}
					]
				}
			]
		}
	],
	"variable": [
		{ "key": "idUsuario", "value": "", "type": "string" }
	]
}
